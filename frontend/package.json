{
  "name": "map-lgb-fond-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:webkit": "playwright test --project=mobile-safari",
    "test:e2e:report": "playwright show-report",
    "test:e2e:screenshots": "README_SCREENSHOTS=1 playwright test e2e/screenshots.spec.ts --project=chromium --workers=1",
    "test:station-search": "esbuild scripts/verifyStationSearch.ts --bundle --platform=node --format=esm --log-level=warning --outfile=/tmp/map-lgb-fond-verify-station-search.mjs && node /tmp/map-lgb-fond-verify-station-search.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "leaflet": "^1.9.4",
    "onnxruntime-web": "^1.20.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "recharts": "^2.15.0",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/leaflet": "^1.9.16",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.8.0"
  }
}
